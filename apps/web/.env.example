# Copie para .env.local (não vai para o Git) e preencha. Veja supabase/LEIA-ME.md.

# ==============================================================================
# VARIÁVEIS PÚBLICAS (vão no bundle do navegador — nunca coloque segredos aqui)
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Flags opcionais de exibição de recursos de IA no navegador ("sim" para ligar):
# NEXT_PUBLIC_IA_EXPLICACAO=sim
# NEXT_PUBLIC_ARGUMENTA_IA_LIGADA=sim
# NEXT_PUBLIC_IA_RELACAO=sim
# NEXT_PUBLIC_IA_INTIMACAO=sim
# NEXT_PUBLIC_IA_PRECEDENTE=sim

# ==============================================================================
# VARIÁVEIS DE SERVIDOR (só no ambiente de deploy / .env.local; nunca no Git)
# ==============================================================================
# Supabase (acesso administrativo e rotas internas):
# SUPABASE_SERVICE_ROLE_KEY=

# Origem pública e controle de origem / administração (docs/deploy/CLOUD_RUN.md):
# SITE_URL=https://ratione.nexojuris.ia.br
# RATIONE_ORIGEM_PUBLICA=https://ratione.nexojuris.ia.br
# RATIONE_HOSTS_CONFIADOS=
# RATIONE_ADMIN_USUARIO_IDS=    (UUIDs separados por vírgula; vazio mantém o painel fechado)

# IA (docs/produto/IA_TAREFAS.md):
# ANTHROPIC_API_KEY=
# IA_EXPLICACAO_LIGADA=sim
# IA_ARGUMENTA_LIGADA=sim       (se vazia, usa IA_EXPLICACAO_LIGADA como fallback legado)
# IA_RELACAO_LIGADA=sim
# IA_INTIMACAO_LIGADA=sim
# IA_PRECEDENTE_LIGADA=sim

# Lembretes por e-mail (F2-10, /api/lembretes/enviar):
# RESEND_API_KEY=
# LEMBRETES_SEGREDO=            (32+ caracteres; autoriza o agendador em /api/lembretes/enviar)
# LEMBRETES_REMETENTE=          (opcional; ex.: Ratione <nao-responda@nexojuris.ia.br>)

# F5-01 — Envio de documentos do Argumenta (desligado por padrão; RIPD seção 7):
# ARGUMENTA_UPLOAD_LIGADO=sim
# DOCUMENTOS_CHAVE=             (32 bytes em base64; cifra os arquivos; sem ela nada é guardado)
# DOCUMENTOS_LIMPEZA_SEGREDO=   (32+ caracteres; autoriza o agendador de limpeza)
# DOCUMENTOS_RETENCAO_DIAS=     (opcional; limita dias de retenção até o máximo de 7 dias)

# F5-10 — Salvar análises do Argumenta (desligado por padrão; RIPD 0.3 seção 7.3):
# ARGUMENTA_SALVAR_LIGADO=sim
# ANALISES_CHAVE=               (32 bytes em base64; cifra as análises salvas; usa DOCUMENTOS_LIMPEZA_SEGREDO na faxina)

# F8-05 — Cobrança Mercado Pago (desligada por padrão; docs/produto/PLANOS_E_COBRANCA.md §7.4):
# COBRANCA_LIGADA=sim
# COBRANCA_AMBIENTE=teste       (teste ou producao)
# COBRANCA_TESTE_EMAILS=        (e-mails autorizados no ambiente de teste, separados por ponto e vírgula)
# MERCADOPAGO_ACCESS_TOKEN=
# MERCADOPAGO_WEBHOOK_SECRET=
