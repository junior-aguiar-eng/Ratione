# Copie para .env.local (não vai para o Git) e preencha. Veja supabase/LEIA-ME.md.
# São valores públicos do projeto Supabase. NUNCA coloque aqui a chave secreta (service_role) nem a senha do banco.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Só no ambiente de deploy (Vercel etc.), NUNCA neste arquivo versionado nem no navegador:
# SUPABASE_SERVICE_ROLE_KEY=   (chave secreta; habilita "Excluir conta" em /api/conta/excluir)
# F5-01, envio de documentos (desligado por padrão; só depois do RIPD, docs/deploy/CLOUD_RUN.md):
# ARGUMENTA_UPLOAD_LIGADO=sim
# DOCUMENTOS_CHAVE=             (32 bytes em base64; cifra os arquivos; sem ela nada é guardado)
# DOCUMENTOS_LIMPEZA_SEGREDO=   (32+ caracteres; autoriza o agendador em /api/documentos/limpar)
# DOCUMENTOS_RETENCAO_DIAS=     (opcional; só reduz o padrão de 7 dias)
