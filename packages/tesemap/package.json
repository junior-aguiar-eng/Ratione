{
  "name": "@ratione/tesemap",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./stj": {
      "types": "./src/stj/index.ts",
      "import": "./src/stj/index.ts",
      "default": "./src/stj/index.ts"
    },
    "./banco": {
      "types": "./src/banco/index.ts",
      "import": "./src/banco/index.ts",
      "default": "./src/banco/index.ts"
    },
    "./stf": {
      "types": "./src/stf/index.ts",
      "import": "./src/stf/index.ts",
      "default": "./src/stf/index.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "coletar:stj": "tsx src/stj/coletar.ts",
    "carregar:tesemap": "tsx src/banco/carregar-supabase.ts",
    "importar:stf": "tsx src/stf/importar.ts",
    "agregar:stf": "tsx src/stf/agregar.ts",
    "importar:stj-sumulas": "tsx src/stj/importar-sumulas.ts",
    "grafo-minimo": "tsx src/banco/grafo-minimo-revisao.ts"
  },
  "dependencies": {
    "@ratione/core": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@ratione/db": "workspace:*",
    "@ratione/normaviva": "workspace:*",
    "@supabase/supabase-js": "^2.117.3",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.3",
    "typescript": "^7.0.2"
  }
}
