{
  "name": "@ratione/normaviva",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./vigencia-futura": {
      "types": "./src/vigenciafutura/avisos.ts",
      "import": "./src/vigenciafutura/avisos.ts",
      "default": "./src/vigenciafutura/avisos.ts"
    },
    "./consulta": {
      "types": "./src/busca/consulta.ts",
      "import": "./src/busca/consulta.ts",
      "default": "./src/busca/consulta.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "coletar": "tsx src/coleta/coletar.ts",
    "conferir": "tsx src/coleta/conferir.ts",
    "coletar:anotadas": "tsx src/coleta/coletar-anotadas.ts",
    "parsear": "tsx src/parser/verificar.ts",
    "versoes": "tsx src/versoes/verificar.ts",
    "relacoes": "tsx src/busca/verificar.ts",
    "historico": "tsx src/historico/gerar.ts",
    "historico:sql": "tsx src/historico/gerar-sql.ts",
    "atualizar": "tsx src/atualizacao/atualizar.ts",
    "feeds": "tsx src/atualizacao/feeds.ts",
    "vigencia": "tsx src/vigenciafutura/atualizar.ts",
    "carregar": "tsx src/busca/carregar-supabase.ts"
  },
  "dependencies": {
    "@ratione/core": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.3",
    "typescript": "^7.0.2",
    "@electric-sql/pglite": "^0.5.8",
    "@ratione/db": "workspace:*",
    "@supabase/supabase-js": "^2.117.3"
  }
}
